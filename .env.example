# Copy this to .env and fill in your values

# Google Gemini API key — free tier, 1500 requests/day
# Get yours at: https://aistudio.google.com/app/apikey
GROQ_API_KEY=gsk_...

# Supabase PostgreSQL connection string (optional)
# Leave blank to use SQLite fallback
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Path to SQLite fallback DB (auto-created if missing)
DUMMY_DB_PATH=admin_dummy.db
