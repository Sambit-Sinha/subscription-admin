# Copy this to .env and fill in your values

# Supabase PostgreSQL connection string
# Find it in: Supabase dashboard → Project → Settings → Database → Connection string (URI mode)
# Leave blank to use SQLite fallback
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Path to SQLite fallback DB (auto-created by dummy_db.py if missing)
DUMMY_DB_PATH=admin_dummy.db

# Your Anthropic API key (required for the agent)
ANTHROPIC_API_KEY=sk-ant-...
